# Copy to backend/.env and fill in. Never commit the real .env.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=main_db

# One bucket for everything — workbooks, item photos, cached output.
# The free plan allows a single bucket; file ids are prefixed raw_/img_/cache_.
BUCKET_ID=bucket_db

# Comma-separated origins allowed to call the API (where the frontend is served from)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
